{
  "dns": {
    "final": "dns-remote",
    "rules": [
      {
        "domain": [
          "dns.quad9.net",
          "cloudflare-dns.com"
        ],
        "server": "dns-direct",
        "strategy": "prefer_ipv4"
      },
      {
        "action": "predefined",
        "domain_suffix": [
          "niko.internal"
        ],
        "rcode": "NXDOMAIN"
      },
      {
        "process_path": [
          "/usr/bin/curl"
        ],
        "server": "dns-direct",
        "strategy": "prefer_ipv4"
      },
      {
        "disable_cache": true,
        "inbound": [
          "tun-in"
        ],
        "server": "dns-fake",
        "strategy": "ipv4_only"
      }
    ],
    "servers": [
      {
        "tag": "dns-local",
        "type": "local"
      },
      {
        "tag": "dns-direct",
        "type": "local"
      },
      {
        "servers": [
          "dns-remote-1",
          "dns-remote-2"
        ],
        "tag": "dns-remote",
        "type": "fallback"
      },
      {
        "detour": "proxy",
        "domain_resolver": {
          "server": "dns-direct",
          "strategy": "prefer_ipv4"
        },
        "path": "/dns-query",
        "server": "cloudflare-dns.com",
        "tag": "dns-remote-1",
        "type": "https"
      },
      {
        "detour": "proxy",
        "domain_resolver": {
          "server": "dns-direct",
          "strategy": "prefer_ipv4"
        },
        "path": "/dns-query",
        "server": "dns.quad9.net",
        "tag": "dns-remote-2",
        "type": "https"
      },
      {
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18",
        "tag": "dns-fake",
        "type": "fakeip"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "endpoints": [],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true
    }
  },
  "inbounds": [
    {
      "address": [
        "172.19.0.1/28",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "interface_name": "niko0",
      "mtu": 1500,
      "stack": "mixed",
      "strict_route": true,
      "tag": "tun-in",
      "type": "tun"
    }
  ],
  "log": {
    "level": "panic"
  },
  "outbounds": [
    {
      "password": "fake-trojan-password",
      "server": "203.0.113.80",
      "server_port": 443,
      "tag": "proxy",
      "tls": {
        "alpn": [
          "h2",
          "http/1.1"
        ],
        "enabled": true,
        "insecure": false,
        "server_name": "trojan.example.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "transport": {
        "headers": {
          "Host": "trojan.example.com"
        },
        "path": "/trojan",
        "type": "ws"
      },
      "type": "trojan"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "bypass",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-direct",
      "strategy": "prefer_ipv4"
    },
    "final": "proxy",
    "rule_set": [],
    "rules": [
      {
        "action": "reject",
        "domain_suffix": [
          "niko.internal"
        ]
      },
      {
        "action": "sniff",
        "inbound": [
          "tun-in",
          "mixed-in"
        ]
      },
      {
        "action": "hijack-dns",
        "port": [
          53
        ]
      },
      {
        "action": "hijack-dns",
        "protocol": [
          "dns"
        ]
      },
      {
        "outbound": "bypass",
        "process_path": [
          "/usr/bin/curl"
        ]
      },
      {
        "ip_is_private": true,
        "outbound": "bypass"
      },
      {
        "action": "reject",
        "ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "source_ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ]
      }
    ]
  }
}
