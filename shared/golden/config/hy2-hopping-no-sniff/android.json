{
  "log": {
    "level": "debug"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-local"
      },
      {
        "type": "udp",
        "tag": "dns-direct",
        "server": "223.5.5.5",
        "domain_resolver": {
          "server": "dns-local",
          "strategy": "ipv4_only"
        }
      },
      {
        "type": "fallback",
        "tag": "dns-remote",
        "servers": [
          "dns-remote-1",
          "dns-remote-2"
        ]
      },
      {
        "type": "tls",
        "tag": "dns-remote-1",
        "server": "1.1.1.1",
        "domain_resolver": {
          "server": "dns-direct",
          "strategy": "ipv4_only"
        },
        "detour": "proxy"
      },
      {
        "type": "https",
        "tag": "dns-remote-2",
        "server": "dns.google",
        "path": "/dns-query",
        "domain_resolver": {
          "server": "dns-direct",
          "strategy": "ipv4_only"
        },
        "detour": "proxy"
      },
      {
        "type": "fakeip",
        "tag": "dns-fake",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "domain": [
          "dns.google",
          "example.com"
        ],
        "strategy": "ipv4_only",
        "server": "dns-direct"
      },
      {
        "domain_suffix": [
          "niko.internal"
        ],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "inbound": [
          "tun-in"
        ],
        "strategy": "ipv4_only",
        "server": "dns-fake",
        "disable_cache": true
      }
    ],
    "final": "dns-remote",
    "strategy": "ipv4_only",
    "optimistic": true
  },
  "inbounds": [
    {
      "mtu": 9000,
      "address": [
        "172.19.0.1/28"
      ],
      "stack": "gvisor",
      "type": "tun",
      "tag": "tun-in"
    }
  ],
  "outbounds": [
    {
      "server": "example.com",
      "up_mbps": 0,
      "down_mbps": 0,
      "obfs": {
        "type": "salamander",
        "password": "secret"
      },
      "password": "user:pass",
      "tls": {
        "enabled": true,
        "server_name": "a.example.com",
        "insecure": true,
        "alpn": [
          "h3"
        ]
      },
      "server_ports": [
        "443:443",
        "5000:6000"
      ],
      "hop_interval": "10s",
      "type": "hysteria2",
      "tag": "proxy"
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "direct",
      "tag": "bypass"
    }
  ],
  "endpoints": [],
  "route": {
    "rules": [
      {
        "domain_suffix": [
          "niko.internal"
        ],
        "action": "reject"
      },
      {
        "port": [
          53
        ],
        "action": "hijack-dns"
      },
      {
        "protocol": [
          "dns"
        ],
        "action": "hijack-dns"
      },
      {
        "source_ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "action": "reject"
      }
    ],
    "rule_set": [],
    "final": "proxy",
    "default_domain_resolver": {
      "server": "dns-direct",
      "strategy": "ipv4_only"
    },
    "auto_detect_interface": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "path": "cache.db"
    }
  }
}
