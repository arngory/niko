{
  "dns": {
    "final": "dns-remote",
    "rules": [
      {
        "domain": [
          "dns.google"
        ],
        "server": "dns-direct",
        "strategy": "ipv4_only"
      },
      {
        "action": "predefined",
        "domain_suffix": [
          "niko.internal"
        ],
        "rcode": "NXDOMAIN"
      },
      {
        "disable_cache": true,
        "inbound": [
          "tun-in"
        ],
        "server": "dns-fake",
        "strategy": "ipv4_only"
      }
    ],
    "servers": [
      {
        "tag": "dns-local",
        "type": "local"
      },
      {
        "tag": "dns-direct",
        "type": "local"
      },
      {
        "detour": "proxy",
        "domain_resolver": {
          "server": "dns-direct",
          "strategy": "ipv4_only"
        },
        "path": "/dns-query",
        "server": "dns.google",
        "tag": "dns-remote",
        "type": "https"
      },
      {
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18",
        "tag": "dns-fake",
        "type": "fakeip"
      }
    ],
    "strategy": "ipv4_only"
  },
  "endpoints": [
    {
      "detour": "proxy",
      "node_info_privacy": true,
      "peers": [
        "tls://198.51.100.70:443",
        "quic://peer.example:443"
      ],
      "private_key": "golden-mesh-key",
      "tag": "yggdrasil",
      "tls_fingerprint": "go",
      "type": "yggdrasil"
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true
    }
  },
  "inbounds": [
    {
      "address": [
        "172.19.0.1/28"
      ],
      "auto_route": true,
      "interface_name": "Niko",
      "mtu": 9000,
      "stack": "gvisor",
      "strict_route": true,
      "tag": "tun-in",
      "type": "tun"
    }
  ],
  "log": {
    "level": "panic"
  },
  "outbounds": [
    {
      "method": "aes-256-gcm",
      "password": "fake-ss-password",
      "server": "198.51.100.10",
      "server_port": 8388,
      "tag": "proxy",
      "type": "shadowsocks"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "bypass",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-direct",
      "strategy": "ipv4_only"
    },
    "final": "proxy",
    "rule_set": [],
    "rules": [
      {
        "action": "reject",
        "domain_suffix": [
          "niko.internal"
        ]
      },
      {
        "inbound": [
          "yggdrasil"
        ],
        "outbound": "direct",
        "port": [
          22
        ],
        "port_range": [
          "8000:8080"
        ]
      },
      {
        "action": "reject",
        "inbound": [
          "yggdrasil"
        ]
      },
      {
        "action": "sniff",
        "inbound": [
          "tun-in",
          "mixed-in"
        ]
      },
      {
        "action": "hijack-dns",
        "port": [
          53
        ]
      },
      {
        "action": "hijack-dns",
        "protocol": [
          "dns"
        ]
      },
      {
        "ip_cidr": [
          "200::/7"
        ],
        "outbound": "yggdrasil"
      },
      {
        "action": "reject",
        "ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "source_ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ]
      }
    ]
  }
}
