{
  "log": {
    "level": "panic"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-local"
      },
      {
        "type": "local",
        "tag": "dns-direct"
      },
      {
        "type": "fallback",
        "tag": "dns-remote",
        "servers": [
          "dns-remote-1",
          "dns-remote-2"
        ],
        "timeout": "8s"
      },
      {
        "type": "https",
        "tag": "dns-remote-1",
        "server": "cloudflare-dns.com",
        "path": "/dns-query",
        "domain_resolver": {
          "server": "dns-direct",
          "strategy": "ipv4_only"
        },
        "detour": "proxy"
      },
      {
        "type": "https",
        "tag": "dns-remote-2",
        "server": "dns.quad9.net",
        "path": "/dns-query",
        "domain_resolver": {
          "server": "dns-direct",
          "strategy": "ipv4_only"
        },
        "detour": "proxy"
      },
      {
        "type": "fakeip",
        "tag": "dns-fake",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "domain": [
          "dns.quad9.net",
          "inner",
          "cloudflare-dns.com"
        ],
        "strategy": "ipv4_only",
        "server": "dns-direct"
      },
      {
        "domain_suffix": [
          "niko.internal"
        ],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "inbound": [
          "tun-in"
        ],
        "strategy": "ipv4_only",
        "server": "dns-fake",
        "disable_cache": true
      }
    ],
    "final": "dns-remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "mtu": 9000,
      "address": [
        "172.19.0.1/28"
      ],
      "stack": "gvisor",
      "type": "tun",
      "tag": "tun-in"
    }
  ],
  "outbounds": [
    {
      "type": "dnstt",
      "tag": "proxy-dnstunnel",
      "public_key": "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd",
      "seal": {
        "key": "exampleSealKeyAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
      },
      "resolver": "https://doh.example.net/dns-query",
      "auth": {
        "node_id": "aaaaaaaabbbbbbbbccccccccdddddddd",
        "service_id": 9,
        "device_key_ref": "raycontrol:aaaaaaaabbbbbbbbccccccccdddddddd:3333333333333333",
        "clock_skew": 4
      },
      "domain": "t.example.com"
    },
    {
      "detour": "proxy-dnstunnel",
      "server": "inner",
      "server_port": 1,
      "uuid": "00000000-0000-4000-8000-000000000008",
      "encryption": "mlkem768x25519plus.native.0rtt.exampleKeyAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "packet_encoding": "",
      "type": "vless",
      "tag": "proxy"
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "direct",
      "tag": "bypass"
    }
  ],
  "endpoints": [],
  "route": {
    "rules": [
      {
        "domain_suffix": [
          "niko.internal"
        ],
        "action": "reject"
      },
      {
        "inbound": [
          "tun-in",
          "mixed-in"
        ],
        "action": "sniff"
      },
      {
        "port": [
          53
        ],
        "action": "hijack-dns"
      },
      {
        "protocol": [
          "dns"
        ],
        "action": "hijack-dns"
      },
      {
        "source_ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "action": "reject"
      }
    ],
    "rule_set": [],
    "final": "proxy",
    "default_domain_resolver": {
      "server": "dns-direct",
      "strategy": "ipv4_only"
    },
    "auto_detect_interface": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "path": "cache.db"
    }
  }
}
