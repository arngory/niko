{
  "log": {
    "level": "panic"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-local"
      },
      {
        "type": "local",
        "tag": "dns-direct"
      },
      {
        "type": "https",
        "tag": "dns-remote",
        "server": "dns.google",
        "path": "/dns-query",
        "domain_resolver": {
          "server": "dns-direct",
          "strategy": "ipv4_only"
        },
        "detour": "proxy"
      },
      {
        "type": "fakeip",
        "tag": "dns-fake",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "domain": [
          "dns.google"
        ],
        "strategy": "ipv4_only",
        "server": "dns-direct"
      },
      {
        "domain_suffix": [
          "niko.internal"
        ],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "inbound": [
          "tun-in"
        ],
        "strategy": "ipv4_only",
        "server": "dns-fake",
        "disable_cache": true
      }
    ],
    "final": "dns-remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "mtu": 9000,
      "address": [
        "172.19.0.1/28"
      ],
      "stack": "gvisor",
      "type": "tun",
      "tag": "tun-in"
    }
  ],
  "outbounds": [
    {
      "outbounds": [
        "Example SS",
        "reality",
        "hy2o"
