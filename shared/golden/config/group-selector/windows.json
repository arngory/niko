{
  "dns": {
    "final": "dns-remote",
    "rules": [
      {
        "domain": [
          "dns.quad9.net",
          "cloudflare-dns.com"
        ],
        "server": "dns-direct",
        "strategy": "ipv4_only"
      },
      {
        "action": "predefined",
        "domain_suffix": [
          "niko.internal"
        ],
        "rcode": "NXDOMAIN"
      },
      {
        "disable_cache": true,
        "inbound": [
          "tun-in"
        ],
        "server": "dns-fake",
        "strategy": "ipv4_only"
      }
    ],
    "servers": [
      {
        "tag": "dns-local",
        "type": "local"
      },
      {
        "tag": "dns-direct",
        "type": "local"
      },
      {
        "servers": [
          "dns-remote-1",
          "dns-remote-2"
        ],
        "tag": "dns-remote",
        "type": "fallback"
      },
      {
        "detour": "proxy",
        "domain_resolver": {
          "server": "dns-direct",
          "strategy": "ipv4_only"
        },
        "path": "/dns-query",
        "server": "cloudflare-dns.com",
        "tag": "dns-remote-1",
        "type": "https"
      },
      {
        "detour": "proxy",
        "domain_resolver": {
          "server": "dns-direct",
          "strategy": "ipv4_only"
        },
        "path": "/dns-query",
        "server": "dns.quad9.net",
        "tag": "dns-remote-2",
        "type": "https"
      },
      {
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18",
        "tag": "dns-fake",
        "type": "fakeip"
      }
    ],
    "strategy": "ipv4_only"
  },
  "endpoints": [],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true
    }
  },
  "inbounds": [
    {
      "address": [
        "172.19.0.1/28"
      ],
      "auto_route": true,
      "interface_name": "Niko",
      "mtu": 9000,
      "stack": "gvisor",
      "strict_route": true,
      "tag": "tun-in",
      "type": "tun"
    }
  ],
  "log": {
    "level": "panic"
  },
  "outbounds": [
    {
      "default": "reality",
      "outbounds": [
        "Example SS",
        "reality",
        "hy2o"
      ],
      "tag": "proxy",
      "type": "selector"
    },
    {
      "method": "aes-256-gcm",
      "password": "fake-ss-password",
      "server": "198.51.100.10",
      "server_port": 8388,
      "tag": "Example SS",
      "type": "shadowsocks"
    },
    {
      "encryption": "mlkem768x25519plus.native.0rtt.exampleKeyAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "flow": "xtls-rprx-vision",
      "packet_encoding": "",
      "server": "203.0.113.7",
      "server_port": 443,
      "tag": "reality",
      "tls": {
        "enabled": true,
        "insecure": false,
        "reality": {
          "enabled": true,
          "mldsa65_verify": "exampleMldsa65VerifyAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "public_key": "examplePublicKeyAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "short_id": "0123456789abcd"
        },
        "server_name": "www.example.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "type": "vless",
      "uuid": "00000000-0000-4000-8000-000000000003"
    },
    {
      "down_mbps": 0,
      "hop_interval": "10s",
      "obfs": {
        "password": "exampleObfsAAAAAAAAAAAAAAAAAAAAA",
        "type": "salamander"
      },
      "password": "00000000-0000-4000-8000-000000000001",
      "server": "203.0.113.7",
      "server_port": 443,
      "tag": "hy2o",
      "tls": {
        "alpn": [
          "h3"
        ],
        "certificate": [],
        "certificate_public_key_sha256": [
          "examplePinSelfSignedAAAAAAAAAAAAAAAAAAAAAAA="
        ],
        "enabled": true,
        "insecure": false,
        "server_name": "0a0b0c0d0e0f.invalid"
      },
      "type": "hysteria2",
      "up_mbps": 0
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "bypass",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-direct",
      "strategy": "ipv4_only"
    },
    "final": "proxy",
    "rule_set": [],
    "rules": [
      {
        "action": "reject",
        "domain_suffix": [
          "niko.internal"
        ]
      },
      {
        "action": "sniff",
        "inbound": [
          "tun-in",
          "mixed-in"
        ]
      },
      {
        "action": "hijack-dns",
        "port": [
          53
        ]
      },
      {
        "action": "hijack-dns",
        "protocol": [
          "dns"
        ]
      },
      {
        "action": "reject",
        "ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "source_ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ]
      }
    ]
  }
}
