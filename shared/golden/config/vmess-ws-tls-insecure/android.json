{
  "log": {
    "level": "panic"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-local"
      },
      {
        "type": "local",
        "tag": "dns-direct"
      },
      {
        "type": "https",
        "tag": "dns-remote",
        "server": "dns.google",
        "path": "/dns-query",
        "domain_resolver": {
          "server": "dns-direct",
          "strategy": "ipv4_only"
        },
        "detour": "proxy"
      },
      {
        "type": "fakeip",
        "tag": "dns-fake",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "domain": [
          "dns.google"
        ],
        "strategy": "ipv4_only",
        "server": "dns-direct"
      },
      {
        "domain_suffix": [
          "niko.internal"
        ],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "inbound": [
          "tun-in"
        ],
        "strategy": "ipv4_only",
        "server": "dns-fake",
        "disable_cache": true
      }
    ],
    "final": "dns-remote",
    "strategy": "prefer_ipv6"
  },
  "inbounds": [
    {
      "mtu": 9000,
      "address": [
        "172.19.0.1/28"
      ],
      "stack": "gvisor",
      "type": "tun",
      "tag": "tun-in"
    }
  ],
  "outbounds": [
    {
      "server": "203.0.113.60",
      "server_port": 443,
      "uuid": "00000000-0000-4000-8000-000000000060",
      "security": "auto",
      "alter_id": 0,
      "tls": {
        "enabled": true,
        "server_name": "cdn.example.com",
        "insecure": true,
        "alpn": [
          "h2",
          "http/1.1"
        ],
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "packet_encoding": "",
      "transport": {
        "path": "/ws",
        "headers": {
          "Host": "cdn.example.com"
        },
        "type": "ws"
      },
      "domain_resolver": {
        "server": "dns-direct",
        "strategy": "ipv4_only"
      },
      "type": "vmess",
      "tag": "proxy"
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "direct",
      "tag": "bypass"
    }
  ],
  "endpoints": [],
  "route": {
    "rules": [
      {
        "domain_suffix": [
          "niko.internal"
        ],
        "action": "reject"
      },
      {
        "inbound": [
          "tun-in",
          "mixed-in"
        ],
        "action": "sniff"
      },
      {
        "port": [
          53
        ],
        "action": "hijack-dns"
      },
      {
        "protocol": [
          "dns"
        ],
        "action": "hijack-dns"
      },
      {
        "source_ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "action": "reject"
      }
    ],
    "rule_set": [],
    "final": "proxy",
    "default_domain_resolver": {
      "server": "dns-direct",
      "strategy": "ipv4_only"
    },
    "auto_detect_interface": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "path": "cache.db"
    }
  }
}
