          "rule-set:https://lists.example.com/geosite-example.srs"
        ],
        "strategy": "ipv4_only",
        "server": "dns-remote"
      },
      {
        "inbound": [
          "tun-in"
        ],
        "strategy": "ipv4_only",
        "server": "dns-fake",
        "disable_cache": true
      }
    ],
    "final": "dns-remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
