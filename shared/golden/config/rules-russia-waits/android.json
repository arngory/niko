        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "domain": [
          "dns.quad9.net",
          "cloudflare-dns.com"
        ],
        "strategy": "ipv4_only",
        "server": "dns-direct"
      },
      {
        "domain_suffix": [
          "niko.internal"
        ],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "rule_set": [
          "geosite:category-ads-all"
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "inbound": [
          "tun-in"
