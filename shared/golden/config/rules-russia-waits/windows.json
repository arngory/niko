{
  "certificate": {
    "store": "chrome"
  },
  "dns": {
    "final": "dns-remote",
    "rules": [
      {
        "domain": [
          "dns.quad9.net",
          "cloudflare-dns.com"
        ],
        "server": "dns-direct",
        "strategy": "ipv4_only"
      },
      {
        "action": "predefined",
        "domain_suffix": [
          "niko.internal"
        ],
        "rcode": "NXDOMAIN"
      },
      {
        "inbound": [
          "tun-in"
        ],
        "rule_set": [
          "rule-set:https://lists.example.com/geosite-example.srs"
        ],
        "server": "dns-fake",
        "strategy": "ipv4_only"
      },
      {
        "rule_set": [
          "rule-set:https://lists.example.com/geosite-example.srs"
        ],
        "server": "dns-remote",
        "strategy": "ipv4_only"
      },
      {
        "disable_cache": true,
        "inbound": [
          "tun-in"
        ],
        "server": "dns-fake",
        "strategy": "ipv4_only"
      }
    ],
    "servers": [
      {
        "tag": "dns-local",
        "type": "local"
      },
      {
        "tag": "dns-direct",
        "type": "local"
      },
      {
        "servers": [
          "dns-remote-1",
          "dns-remote-2"
        ],
        "tag": "dns-remote",
        "type": "fallback"
      },
      {
        "detour": "proxy",
        "domain_resolver": {
          "server": "dns-direct",
          "strategy": "ipv4_only"
        },
        "path": "/dns-query",
        "server": "cloudflare-dns.com",
        "tag": "dns-remote-1",
        "type": "https"
      },
      {
        "detour": "proxy",
        "domain_resolver": {
          "server": "dns-direct",
          "strategy": "ipv4_only"
        },
        "path": "/dns-query",
        "server": "dns.quad9.net",
        "tag": "dns-remote-2",
        "type": "https"
      },
      {
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18",
        "tag": "dns-fake",
        "type": "fakeip"
      }
    ],
    "strategy": "ipv4_only"
  },
  "endpoints": [],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true
    }
  },
  "inbounds": [
    {
      "address": [
        "172.19.0.1/28"
      ],
      "auto_route": true,
      "interface_name": "Niko",
      "mtu": 9000,
      "stack": "gvisor",
      "strict_route": true,
      "tag": "tun-in",
      "type": "tun"
    }
  ],
  "log": {
    "level": "panic"
  },
  "outbounds": [
    {
      "method": "aes-256-gcm",
      "password": "fake-ss-password",
      "server": "198.51.100.10",
      "server_port": 8388,
      "tag": "proxy",
      "type": "shadowsocks"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "bypass",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-direct",
      "strategy": "ipv4_only"
    },
    "final": "proxy",
    "rule_set": [
      {
        "format": "binary",
        "tag": "rule-set:https://lists.example.com/geosite-example.srs",
        "type": "remote",
        "update_interval": "24h",
        "url": "https://lists.example.com/geosite-example.srs"
      },
      {
        "format": "binary",
        "tag": "rule-set:https://lists.example.com/geoip-example.srs?v=1",
        "type": "remote",
        "update_interval": "24h",
        "url": "https://lists.example.com/geoip-example.srs?v=1"
      }
    ],
    "rules": [
      {
        "action": "reject",
        "domain_suffix": [
          "niko.internal"
        ]
      },
      {
        "action": "sniff",
        "inbound": [
          "tun-in",
          "mixed-in"
        ]
      },
      {
        "action": "hijack-dns",
        "port": [
          53
        ]
      },
      {
        "action": "hijack-dns",
        "protocol": [
          "dns"
        ]
      },
      {
        "action": "reject",
        "network": [
          "udp"
        ],
        "port": [
          443
        ],
        "port_range": []
      },
      {
        "ip_is_private": true,
        "outbound": "proxy",
        "rule_set": [
          "rule-set:https://lists.example.com/geosite-example.srs",
          "rule-set:https://lists.example.com/geoip-example.srs?v=1"
        ]
      },
      {
        "action": "reject",
        "ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "source_ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ]
      }
    ]
  }
}
