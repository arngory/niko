{
  "presets": {
    "tlsrec_sni": {"tlsrec": ["sni+1"]},
    "split_sni": {"split": [{"at": "1", "mode": "split"}, {"at": "midsld", "mode": "split"}]},
    "disoob_sld": {"split": [{"at": "midsld", "mode": "disoob"}]},
    "disorder_1": {"split": [{"at": "1", "mode": "disorder"}]}
  },
  "cases": [
    {"in": "-s 1 -q 1+sm", "out": {"split": [{"at": "1", "mode": "split"}, {"at": "midhost+1", "mode": "disoob"}]}},
    {"in": "ciadpi --disorder 1 --tlsrec 1+s", "out": {"split": [{"at": "1", "mode": "disorder"}], "tlsrec": ["sni+1"]}},
    {"in": "  -s1   -o3+s -e b ", "out": {"split": [{"at": "1", "mode": "split"}, {"at": "sni+3", "mode": "oob"}], "oob_byte": "b"}},
    {"in": "--split=1:3:5", "out": {"split": [{"at": "1", "mode": "split"}, {"at": "6", "mode": "split"}, {"at": "11", "mode": "split"}]}},
    {"in": "-r 1 -r 3+se -r -10 -r 0+h", "out": {"tlsrec": ["6", "endhost+3", "-10", "host"]}},
    {"in": "-d -1+he -s 0+sm --oob=-2+s", "out": {"split": [{"at": "endhost-1", "mode": "disorder"}, {"at": "midhost", "mode": "split"}, {"at": "sni-2", "mode": "oob"}]}},
    {"in": "-s -2:3:1", "out": {"split": [{"at": "-2", "mode": "split"}, {"at": "-1", "mode": "split"}]}},
    {"in": "-s 5+n -r 5+n -r 5+ns", "out": {"split": [{"at": "5", "mode": "split"}], "tlsrec": ["10", "5"]}},
    {"in": "-s -3+ne -s 2+ss", "out": {"split": [{"at": "-3", "mode": "split"}, {"at": "sni+2", "mode": "split"}]}},
    {"in": "/usr/bin/ciadpi -s 1", "out": {"split": [{"at": "1", "mode": "split"}]}},

    {"in": "", "error": "empty"},
    {"in": "ciadpi", "error": "empty"},
    {"in": "--dpi-desync=fake,multisplit --dpi-desync-split-pos=1,midsld", "error": "nfqws"},
    {"in": "--filter-tcp=443 --split-pos=1,midsld --disorder", "error": "nfqws"},
    {"in": "-f -1", "error": "fake", "flag": "-f"},
    {"in": "-s 1 -t 8", "error": "fake", "flag": "-t"},
    {"in": "-S", "error": "fake", "flag": "-S"},
    {"in": "-n x.example", "error": "fake", "flag": "-n"},
    {"in": "-Q rand", "error": "fake", "flag": "-Q"},
    {"in": "--fake-sni=x.example", "error": "fake", "flag": "--fake-sni"},
    {"in": "--fake-whatever 1", "error": "fake", "flag": "--fake-whatever"},
    {"in": "-A torst -s 1", "error": "auto", "flag": "-A"},
    {"in": "-At,r,s", "error": "auto", "flag": "-A"},
    {"in": "--auto=torst", "error": "auto", "flag": "--auto"},
    {"in": "-M h", "error": "unsupported", "flag": "-M"},
    {"in": "--mod-http=h,d", "error": "unsupported", "flag": "--mod-http"},
    {"in": "-s 1 -K t", "error": "unsupported", "flag": "-K"},
    {"in": "--port 1080", "error": "unsupported", "flag": "--port"},
    {"in": "-s", "error": "no_value", "flag": "-s"},
    {"in": "-s 1 --tlsrec", "error": "no_value", "flag": "--tlsrec"},
    {"in": "-s 1+x", "error": "bad_position", "flag": "-s", "value": "1+x"},
    {"in": "-s 1+sr", "error": "bad_position", "flag": "-s", "value": "1+sr"},
    {"in": "-s 1+nm", "error": "bad_position", "flag": "-s", "value": "1+nm"},
    {"in": "-s 3+ne", "error": "bad_position", "flag": "-s", "value": "3+ne"},
    {"in": "-s 010", "error": "bad_position", "flag": "-s", "value": "010"},
    {"in": "-s 0x10", "error": "bad_position", "flag": "-s", "value": "0x10"},
    {"in": "-s 1:0", "error": "bad_position", "flag": "-s", "value": "1:0"},
    {"in": "-d 70000", "error": "bad_position", "flag": "-d", "value": "70000"},
    {"in": "-s sni+1", "error": "bad_position", "flag": "-s", "value": "sni+1"},
    {"in": "-e ab", "error": "bad_oob_data", "flag": "-e", "value": "ab"},
    {"in": "-s 1 foo", "error": "unexpected", "value": "foo"},
    {"in": "-1", "error": "unexpected", "value": "-1"},
    {"in": "-e x", "error": "nothing"},
    {"in": "-s 1:40:1 -r 1:30:1", "error": "too_many", "flag": "-r", "value": "1:30:1"}
  ]
}
