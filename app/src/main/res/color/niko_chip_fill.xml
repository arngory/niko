<?xml version="1.0" encoding="utf-8"?>
<!-- a chip's fill (a tag, a segment): ink when chosen, surface-2 otherwise -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.4" android:color="@color/niko_ink" android:state_checked="true" android:state_enabled="false" />
    <item android:alpha="0.4" android:color="@color/niko_surface_2" android:state_enabled="false" />
    <item android:color="@color/niko_ink" android:state_checked="true" />
    <item android:color="@color/niko_surface_2" />
</selector>
