<?xml version="1.0" encoding="utf-8"?>
<!-- the Niko theme's connect button, its halo: danger after a failed start, line-strong while connected, line at rest -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:color="@color/niko_danger" app:state_failed="true" />
    <item android:color="@color/niko_line_strong" android:state_checked="true" />
    <item android:color="@color/niko_line" />
</selector>
