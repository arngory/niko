<?xml version="1.0" encoding="utf-8"?>
<!-- the Niko theme's connect button, its fill (the window's ConnectButton, D-MAIN-04): danger-soft after a failed start,
     ink while connected (ink-pressed pressed), surface-2 at rest (surface-3 pressed) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:color="@color/niko_danger_soft" app:state_failed="true" />
    <item android:color="@color/niko_ink_pressed" android:state_checked="true" android:state_pressed="true" />
    <item android:color="@color/niko_ink" android:state_checked="true" />
    <item android:color="@color/niko_surface_3" android:state_pressed="true" />
    <item android:color="@color/niko_surface_2" />
</selector>
