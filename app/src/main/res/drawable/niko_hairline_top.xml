<?xml version="1.0" encoding="utf-8"?>
<!-- a hairline of line along the top of a bar, drawn over it: the Niko theme's statistics bar -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:height="@dimen/niko_stroke_hairline"
        android:gravity="top|fill_horizontal">
        <shape android:shape="rectangle">
            <solid android:color="@color/niko_line" />
        </shape>
    </item>
</layer-list>
