<?xml version="1.0" encoding="utf-8"?>
<!-- the button, stopped: the ring closes into the small point -->
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_service_idle">
    <target android:name="exit">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="pathData"
                    android:duration="@android:integer/config_mediumAnimTime"
                    android:valueFrom="M59.5,77a6.5,6.5 0,1 0,13.0,0a6.5,6.5 0,1 0,-13.0,0Z"
                    android:valueTo="M60,77a6,6 0,1 0,12,0a6,6 0,1 0,-12,0Z"
                    android:valueType="pathType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:duration="@android:integer/config_mediumAnimTime"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="strokeWidth"
                    android:duration="@android:integer/config_mediumAnimTime"
                    android:valueFrom="4"
                    android:valueTo="0"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
