<?xml version="1.0" encoding="utf-8"?>
<!-- the button, stopping: the large point shrinks back into a ring -->
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_service_busy">
    <target android:name="exit">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="pathData"
                    android:duration="@android:integer/config_mediumAnimTime"
                    android:valueFrom="M57,77a9,9 0,1 0,18,0a9,9 0,1 0,-18,0Z"
                    android:valueTo="M59.5,77a6.5,6.5 0,1 0,13.0,0a6.5,6.5 0,1 0,-13.0,0Z"
                    android:valueType="pathType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:duration="@android:integer/config_mediumAnimTime"
                    android:valueFrom="1"
                    android:valueTo="0"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="strokeWidth"
                    android:duration="@android:integer/config_mediumAnimTime"
                    android:valueFrom="0"
                    android:valueTo="4"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
