<?xml version="1.0" encoding="utf-8"?>
<!-- a capsule (radius-full) 52 × 32: the track of every switch of the Niko theme; its padding keeps the thumb 6dp
     from either end -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="16dp" />
    <size android:width="52dp" android:height="32dp" />
    <solid android:color="@color/niko_switch_track_fill" />
    <stroke android:width="2dp" android:color="@color/niko_switch_track_stroke" />
    <padding android:left="6dp" android:right="6dp" />
</shape>
