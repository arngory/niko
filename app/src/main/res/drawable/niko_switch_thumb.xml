<?xml version="1.0" encoding="utf-8"?>
<!-- the thumb: a 20dp circle in the middle of the 32dp track's height. Its width is the circle's: the switch is
     max(switchMinWidth, 2 × thumb + the track's padding) wide, 52dp, and the thumb travels 20dp, 6dp from each end -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="6dp" android:top="6dp">
        <shape android:shape="oval">
            <size android:width="20dp" android:height="20dp" />
            <solid android:color="@color/niko_switch_thumb" />
        </shape>
    </item>
</layer-list>
