<?xml version="1.0" encoding="utf-8"?>

<resources>
    <attr name="colorMaterial100" format="color" />
    <attr name="accentOrTextSecondary" format="color" />
    <attr name="primaryOrTextPrimary" format="color" />
    <attr name="whiteOrTextPrimary" format="color" />
    <!-- the shadow under the bars (the app bar, the group and tool tabs); Niko has none: its surfaces part the layers -->
    <attr name="barElevation" format="dimension" />
    <!-- the bars' fill (the app bar, the group and tool tabs, Custom Tabs): colorPrimary in the colour themes; Niko keeps
         colorPrimary the accent, ink, which Material's fields, buttons and indicators take, and fills its bars with
         surface-0 -->
    <attr name="barBackground" format="color" />
    <!-- the settings' rows in groups: surface-1 containers of radius-md with hairlines between rows (the Niko theme,
         NikoPreferenceGroups); off in the colour themes -->
    <attr name="nikoGroupedPreferences" format="boolean" />
    <!-- a tool's action (the backup, the debug screen): Niko's tonal button, the colour themes' coloured one -->
    <attr name="nikoTonalButtonStyle" format="reference" />
    <!-- a chip that is on or off (show the system's apps) -->
    <attr name="nikoFilterChipStyle" format="reference" />
</resources>
