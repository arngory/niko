            app:title="@string/tls_fragment_bypass"
            app:useSimpleSummaryProvider="true" />
        <io.niko.ui.SimpleMenuPreference
            app:defaultValue="24"
            app:entries="@array/rule_set_update_entries"
            app:entryValues="@array/rule_set_update_hours"
            app:key="ruleSetUpdateHours"
            app:title="@string/rule_set_update_interval"
            app:useSimpleSummaryProvider="true" />
        <io.niko.ui.SimpleMenuPreference
            app:defaultValue="1"
            app:entries="@array/traffic_sniffing_values"
            app:entryValues="@array/int_array_2"
            app:icon="@drawable/ic_l_scan_search"
            app:key="trafficSniffing"
            app:title="@string/traffic_sniffing"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:icon="@drawable/ic_l_locate"
            app:key="resolveDestination"
            app:summary="@string/resolve_destination_summary"
            app:title="@string/resolve_destination" />
        <io.niko.ui.SimpleMenuPreference
            app:defaultValue="0"
            app:entries="@array/ipv6_mode"
            app:entryValues="@array/int_array_4"
            app:icon="@drawable/ic_l_hexagon"
            app:key="ipv6Mode"
            app:title="@string/ipv6"
            app:useSimpleSummaryProvider="true" />
        <io.niko.ui.SimpleMenuPreference
            app:defaultValue="0"
            app:entries="@array/rules_dat_provider"
            app:entryValues="@array/int_array_4"
            app:icon="@drawable/ic_l_folder_cog"
            app:key="rulesProvider"
            app:title="@string/route_rules_provider"
            app:useSimpleSummaryProvider="true" />
