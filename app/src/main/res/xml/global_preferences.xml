            app:icon="@drawable/ic_l_file_json"
            app:key="globalCustomConfig"
            app:title="@string/custom_config"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cag_route">
        <SwitchPreference
            app:icon="@drawable/ic_l_layout_grid"
            app:key="proxyApps"
            app:summary="@string/proxied_apps_summary"
            app:title="@string/proxied_apps" />
        <SwitchPreference
            app:icon="@drawable/ic_l_house"
            app:key="bypassLan"
            app:title="@string/route_opt_bypass_lan" />
        <SwitchPreference
            app:key="bypassLanInCore"
            app:title="@string/bypass_lan_in_core" />
        <SwitchPreference
            app:defaultValue="false"
            app:key="refuseQuicOverStreams"
            app:summary="@string/refuse_quic_over_streams_summary"
            app:title="@string/refuse_quic_over_streams" />
        <SwitchPreference
            app:defaultValue="false"
            app:key="honestConnect"
            app:summary="@string/honest_connect_summary"
            app:title="@string/honest_connect" />
        <SwitchPreference
            app:defaultValue="false"
            app:key="icmpThroughNode"
            app:summary="@string/icmp_through_node_summary"
            app:title="@string/icmp_through_node" />
        <SwitchPreference
            app:defaultValue="false"
            app:key="icmpNoLocalReply"
            app:summary="@string/icmp_no_local_reply_summary"
            app:title="@string/icmp_no_local_reply" />
        <io.niko.ui.SimpleMenuPreference
            app:defaultValue="0"
            app:entries="@array/tls_fragment_values"
            app:entryValues="@array/int_array_3"
