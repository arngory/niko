    <PreferenceCategory app:title="@string/cag_dns">
        <EditTextPreference
            app:defaultValue="https://dns.google/dns-query"
            app:icon="@drawable/ic_l_cloud"
            app:key="remoteDns"
            app:title="@string/remote_dns"
            app:useSimpleSummaryProvider="true" />
        <io.niko.ui.SimpleMenuPreference
            app:defaultValue="auto"
            app:entries="@array/dns_network_select"
            app:entryValues="@array/dns_network_select"
            app:key="domain_strategy_for_remote"
            app:title="@string/domain_strategy_for_remote"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:defaultValue="local"
            app:dialogMessage="@string/direct_dns_help"
            app:icon="@drawable/ic_l_signpost"
            app:key="directDns"
            app:title="@string/direct_dns"
            app:useSimpleSummaryProvider="true" />
        <io.niko.ui.SimpleMenuPreference
            app:defaultValue="auto"
            app:entries="@array/dns_network_select"
            app:entryValues="@array/dns_network_select"
            app:key="domain_strategy_for_direct"
            app:title="@string/domain_strategy_for_direct"
            app:useSimpleSummaryProvider="true" />
        <io.niko.ui.SimpleMenuPreference
            app:defaultValue="auto"
            app:entries="@array/dns_network_select"
            app:entryValues="@array/dns_network_select"
            app:key="domain_strategy_for_server"
            app:title="@string/domain_strategy_for_server"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_l_split"
            app:key="enableDnsRouting"
            app:summary="@string/dns_routing_message"
            app:title="@string/enable_dns_routing" />
        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_l_ghost"
            app:key="enableFakeDns"
            app:summary="@string/fakedns_message"
            app:title="@string/enable_fakedns" />
        <SwitchPreference
            app:icon="@drawable/ic_l_history"
            app:key="dnsOptimisticCache"
            app:summary="@string/dns_optimistic_cache_sum"
            app:title="@string/dns_optimistic_cache" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/inbound_settings">
        <EditTextPreference
            app:icon="@drawable/ic_l_ethernet_port"
            app:key="mixedPort"
            app:title="@string/port_proxy"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="mixedUsername"
            app:title="@string/local_proxy_username"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="mixedPassword"
            app:title="@string/local_proxy_password" />
        <SwitchPreference
            app:defaultValue="false"
            app:key="localProxyNoAuthInVpn"
            app:summary="@string/local_proxy_no_auth_in_vpn_sum"
            app:title="@string/local_proxy_no_auth_in_vpn" />
        <SwitchPreference
            app:defaultValue="false"
            app:dependency="localProxyNoAuthInVpn"
            app:key="appendHttpProxy"
            app:summary="@string/append_http_proxy_sum"
            app:title="@string/append_http_proxy" />
        <SwitchPreference
            app:icon="@drawable/ic_l_wifi"
            app:key="allowAccess"
            app:summary="@string/allow_access_sum"
            app:title="@string/allow_access" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/yggdrasil">
        <SwitchPreference
            app:icon="@drawable/ic_l_tree_deciduous"
            app:key="yggdrasilEnabled"
            app:summary="@string/yggdrasil_summary"
            app:title="@string/yggdrasil_enable" />
        <EditTextPreference
            app:dependency="yggdrasilEnabled"
            app:dialogMessage="@string/yggdrasil_peers_help"
            app:key="yggdrasilPeers"
            app:title="@string/yggdrasil_peers"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:dependency="yggdrasilEnabled"
            app:key="yggdrasilPeersViaProxy"
            app:summary="@string/yggdrasil_peers_via_proxy_summary"
            app:title="@string/yggdrasil_peers_via_proxy" />
        <SwitchPreference
            app:defaultValue="true"
            app:dependency="yggdrasilEnabled"
            app:key="yggdrasilTlsChrome"
            app:summary="@string/yggdrasil_tls_chrome_summary"
            app:title="@string/yggdrasil_tls_chrome" />
        <SwitchPreference
            app:dependency="yggdrasilEnabled"
            app:key="yggdrasilAllowInbound"
            app:summary="@string/yggdrasil_allow_inbound_summary"
            app:title="@string/yggdrasil_allow_inbound" />
        <EditTextPreference
            app:dependency="yggdrasilAllowInbound"
            app:dialogMessage="@string/yggdrasil_inbound_ports_help"
            app:key="yggdrasilInboundPorts"
            app:title="@string/yggdrasil_inbound_ports"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:dependency="yggdrasilEnabled"
            app:key="yggdrasilAddress"
            app:title="@string/yggdrasil_address" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/raycontrol">
        <Preference
            app:icon="@drawable/ic_l_server_cog"
            app:key="raycontrolNodesView"
            app:title="@string/raycontrol_nodes" />
        <SwitchPreference
            app:defaultValue="true"
            app:key="raycontrolAutoSwitch"
            app:summary="@string/raycontrol_auto_switch_summary"
            app:title="@string/raycontrol_auto_switch" />
        <SwitchPreference
            app:defaultValue="false"
            app:key="raycontrolBrutal"
            app:summary="@string/raycontrol_brutal_summary"
            app:title="@string/raycontrol_brutal" />
        <SwitchPreference
            app:defaultValue="false"
            app:key="raycontrolReports"
            app:summary="@string/raycontrol_reports_summary"
            app:title="@string/raycontrol_reports" />
        <EditTextPreference
            app:defaultValue="auto"
            app:dialogMessage="@string/raycontrol_dnstt_resolver_help"
            app:key="raycontrolDnsttResolver"
            app:title="@string/raycontrol_dnstt_resolver"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:defaultValue="auto"
            app:dialogMessage="@string/raycontrol_masterdns_resolvers_help"
            app:key="raycontrolMasterDnsResolvers"
            app:title="@string/raycontrol_masterdns_resolvers"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

