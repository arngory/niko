<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:icon="@drawable/ic_l_tag"
        app:key="groupName"
        app:title="@string/group_name"
        app:useSimpleSummaryProvider="true" />

    <io.niko.ui.SimpleMenuPreference
        app:defaultValue="0"
        app:entries="@array/group_types"
        app:entryValues="@array/int_array_2"
        app:icon="@drawable/ic_l_shapes"
        app:key="groupType"
        app:title="@string/group_type"
        app:useSimpleSummaryProvider="true" />

    <io.niko.ui.SimpleMenuPreference
        app:defaultValue="0"
        app:entries="@array/group_orders"
        app:entryValues="@array/int_array_3"
        app:icon="@drawable/ic_l_arrow_down_a_z"
        app:key="groupOrder"
        app:title="@string/group_order"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreference
        app:icon="@drawable/ic_l_mouse_pointer_click"
        app:key="groupIsSelector"
        app:title="@string/use_selector" />

    <SwitchPreference
        app:icon="@drawable/ic_l_zap"
        app:key="groupAutoSelect"
        app:summary="@string/group_auto_select_sum"
        app:title="@string/group_auto_select" />

    <io.niko.widget.OutboundPreference
        app:icon="@drawable/ic_l_log_in"
        app:key="groupFrontProxy"
        app:title="@string/front_proxy"
        app:useSimpleSummaryProvider="true" />

    <io.niko.widget.OutboundPreference
        app:icon="@drawable/ic_l_log_out"
        app:key="groupLandingProxy"
        app:title="@string/landing_proxy"
        app:useSimpleSummaryProvider="true" />

    <PreferenceCategory
        app:key="groupSubscription"
        app:title="@string/subscription_settings">

        <io.niko.widget.LinkOrContentPreference
            app:icon="@drawable/ic_l_link"
            app:key="subscriptionLink"
            app:title="@string/group_subscription_link"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreference
            app:icon="@drawable/ic_l_search"
            app:key="subscriptionForceResolve"
            app:summary="@string/force_resolve_sum"
            app:title="@string/force_resolve" />

        <SwitchPreference
            app:icon="@drawable/ic_l_copy_minus"
            app:key="subscriptionDeduplication"
            app:summary="@string/deduplication_sum"
            app:title="@string/deduplication" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="subscriptionUpdate"
        app:title="@string/update_settings">
        <SwitchPreference
            app:icon="@drawable/ic_l_plug"
            app:key="subscriptionUpdateWhenConnectedOnly"
            app:summary="@string/update_when_connected_only_sum"
            app:title="@string/update_when_connected_only" />
        <io.niko.widget.UserAgentPreference
            app:icon="@drawable/ic_l_monitor_smartphone"
            app:key="subscriptionUserAgent"
            app:title="@string/subscription_user_agent"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:icon="@drawable/ic_l_cpu"
            app:key="subscriptionSendHwid"
            app:summary="@string/subscription_send_hwid_sum"
            app:title="@string/subscription_send_hwid" />
        <SwitchPreference
            app:icon="@drawable/ic_l_refresh_cw"
            app:key="subscriptionAutoUpdate"
            app:title="@string/auto_update" />
        <EditTextPreference
            app:defaultValue="1440"
            app:icon="@drawable/ic_l_timer"
            app:key="subscriptionAutoUpdateDelay"
            app:title="@string/auto_update_delay"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

</PreferenceScreen>