<?xml version="1.0" encoding="utf-8"?>
<!-- Android 10 and 11 (12 and newer: backup_rules): only a device-to-device transfer carries the profiles. The
     settings stay on the device: they hold this install's
     keys (the mesh key, the raycontrol nodes, whose device keys are wrapped by this device's Keystore and cannot be
     opened on another; the API secrets), which another device must not take over. -->
<full-backup-content xmlns:tools="http://schemas.android.com/tools"
                     tools:ignore="FullBackupContent">
    <include domain="database" path="sager_net.db" requireFlags="deviceToDeviceTransfer"/>
    <!-- the journal: profiles written since the last checkpoint live there only -->
    <include domain="database" path="sager_net.db-wal" requireFlags="deviceToDeviceTransfer"/>
</full-backup-content>
