<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:icon="@drawable/ic_l_tag"
        app:key="profileName"
        app:title="@string/profile_name"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreference
        app:icon="@drawable/ic_l_log_out"
        app:key="isOutboundOnly"
        app:title="@string/is_outbound_only" />

    <io.niko.ui.EditConfigPreference
        app:icon="@drawable/ic_l_file_json"
        app:key="serverConfig"
        app:title="@string/custom_config"
        app:useSimpleSummaryProvider="true" />

</PreferenceScreen>