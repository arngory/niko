<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:icon="@drawable/ic_l_tag"
        app:key="profileName"
        app:title="@string/profile_name"
        app:useSimpleSummaryProvider="true" />

    <io.niko.ui.SimpleMenuPreference
        app:defaultValue="0"
        app:entries="@array/balancer_type"
        app:entryValues="@array/int_array_2"
        app:icon="@drawable/ic_l_shapes"
        app:key="balancerType"
        app:title="@string/balancer_type"
        app:useSimpleSummaryProvider="true" />

    <io.niko.ui.SimpleMenuPreference
        app:entries="@array/balancer_strategy_entry"
        app:entryValues="@array/balancer_strategy_value"
        app:icon="@drawable/ic_l_shuffle"
        app:key="balancerStrategy"
        app:title="@string/balancer_strategy"
        app:useSimpleSummaryProvider="true" />

    <io.niko.widget.GroupPreference
        app:icon="@drawable/ic_l_folder"
        app:key="balancerGroup"
        app:title="@string/menu_group"
        app:useSimpleSummaryProvider="true" />

</PreferenceScreen>