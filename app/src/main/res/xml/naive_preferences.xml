<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:icon="@drawable/ic_l_tag"
        app:key="profileName"
        app:title="@string/profile_name"
        app:useSimpleSummaryProvider="true" />

    <PreferenceCategory app:title="@string/proxy_cat">

        <EditTextPreference
            app:icon="@drawable/ic_l_server"
            app:key="serverAddress"
            app:title="@string/server_address"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_l_ethernet_port"
            app:key="serverPort"
            app:title="@string/server_port"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_l_user"
            app:key="serverUsername"
            app:title="@string/username_opt"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogLayout="@layout/layout_password_dialog"
            app:icon="@drawable/ic_l_key_round"
            app:key="serverPassword"
            app:title="@string/password_opt" />
        <io.niko.ui.SimpleMenuPreference
            android:layout_height="match_parent"
            app:defaultValue="https"
            app:entries="@array/naive_proto_entry"
            app:entryValues="@array/naive_proto_value"
            app:icon="@drawable/ic_l_layers"
            app:key="serverProtocol"
            app:title="@string/protocol"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_l_list_plus"
            app:key="serverHeaders"
            app:title="@string/extra_headers"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_l_globe"
            app:key="serverSNI"
            app:title="@string/sni"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_l_file_badge"
            app:key="serverCertificates"
            app:title="@string/certificates"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogMessage="@string/naive_insecure_concurrency_summary"
            app:icon="@drawable/ic_l_triangle_alert"
            app:key="serverInsecureConcurrency"
            app:title="@string/naive_insecure_concurrency"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="sing-box server">
        <SwitchPreference
            app:key="sUoT"
            app:summary="@string/naive_uot_summary"
            app:title="@string/naive_uot" />
    </PreferenceCategory>
</PreferenceScreen>