<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:icon="@drawable/ic_l_tag"
        app:key="name"
        app:title="@string/profile_name"
        app:useSimpleSummaryProvider="true" />

    <PreferenceCategory app:title="@string/proxy_cat">

        <EditTextPreference
            app:icon="@drawable/ic_l_server"
            app:key="serverAddress"
            app:title="@string/server_address"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_l_ethernet_port"
            app:key="serverPort"
            app:title="@string/server_port"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_l_user"
            app:key="username"
            app:title="@string/username_opt"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogLayout="@layout/layout_password_dialog"
            app:icon="@drawable/ic_l_key_round"
            app:key="password"
            app:title="@string/password_opt" />
        <EditTextPreference
            app:dialogLayout="@layout/layout_password_dialog"
            app:icon="@drawable/ic_l_id_card"
            app:key="uuid"
            app:title="@string/uuid" />
        <EditTextPreference
            app:icon="@drawable/ic_l_repeat"
            app:key="alterId"
            app:title="@string/alter_id"
            app:useSimpleSummaryProvider="true" />
        <io.niko.ui.SimpleMenuPreference
            app:entries="@array/vmess_encryption_value"
            app:entryValues="@array/vmess_encryption_value"
            app:icon="@drawable/ic_l_lock"
            app:key="encryption"
            app:title="@string/encryption"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogMessage="@string/vless_encryption_help"
            app:icon="@drawable/ic_l_lock"
            app:key="vlessEncryption"
            app:title="@string/vless_encryption"
            app:useSimpleSummaryProvider="true" />
        <io.niko.ui.SimpleMenuPreference
            app:entries="@array/packet_encoding_entry"
            app:entryValues="@array/int_array_3"
            app:icon="@drawable/ic_l_package"
            app:key="packetEncoding"
            app:title="@string/packet_encoding"
            app:useSimpleSummaryProvider="true" />
        <io.niko.ui.SimpleMenuPreference
            app:entries="@array/networks_value"
            app:entryValues="@array/networks_value"
            app:icon="@drawable/ic_l_network"
            app:key="type"
            app:title="@string/network"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_l_at_sign"
            app:key="host"
            app:title="@string/http_host"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_l_slash"
            app:key="path"
            app:title="@string/http_path"
            app:useSimpleSummaryProvider="true" />
        <io.niko.ui.SimpleMenuPreference
            app:entries="@array/transport_layer_encryption_value"
            app:entryValues="@array/transport_layer_encryption_value"
            app:icon="@drawable/ic_l_shield"
            app:key="security"
            app:title="@string/security"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="serverXhttpCategory"
        app:title="XHTTP">
        <io.niko.ui.SimpleMenuPreference
            app:defaultValue="auto"
            app:entries="@array/xhttp_modes"
            app:entryValues="@array/xhttp_modes"
            app:icon="@drawable/ic_l_settings_2"
            app:key="xhttpMode"
            app:title="@string/xhttp_mode"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogMessage="@string/xhttp_extra_help"
            app:icon="@drawable/ic_l_braces"
            app:key="xhttpExtra"
            app:title="@string/xhttp_extra"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="serverWsCategory"
        app:title="@string/cag_ws">
        <EditTextPreference
            app:defaultValue="0"
            app:icon="@drawable/ic_l_fast_forward"
            app:key="wsMaxEarlyData"
            app:title="@string/ws_max_early_data"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:icon="@drawable/ic_l_heading"
            app:key="earlyDataHeaderName"
            app:title="@string/early_data_header_name"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="serverSecurityCategory"
        app:title="@string/security_settings">
        <EditTextPreference
            app:icon="@drawable/ic_l_globe"
            app:key="sni"
            app:title="@string/sni"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_l_list_ordered"
            app:key="alpn"
            app:title="@string/alpn"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_l_file_badge"
            app:key="certificates"
            app:title="@string/certificates"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:icon="@drawable/ic_l_shield_off"
            app:key="allowInsecure"
            app:summary="@string/allow_insecure_sum"
            app:title="@string/allow_insecure" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="serverTlsCamouflageCategory"
        app:title="@string/tls_camouflage_settings">
        <io.niko.ui.SimpleMenuPreference
            app:defaultValue=""
            app:entries="@array/utls_fingerprint_entry"
            app:entryValues="@array/utls_fingerprint_entry"
            app:icon="@drawable/ic_l_fingerprint"
            app:key="utlsFingerprint"
            app:title="@string/utls_fingerprint"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_l_key_square"
            app:key="realityPubKey"
            app:title="Reality Public Key"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_l_hash"
            app:key="realityShortId"
            app:title="Reality ShortId"
            app:useSimpleSummaryProvider="true" />
        <io.niko.ui.SimpleMenuPreference
            app:defaultValue=""
            app:entries="@array/reality_key_share_entries"
            app:entryValues="@array/reality_key_share_values"
            app:icon="@drawable/ic_l_arrow_left_right"
            app:key="realityKeyShare"
            app:title="@string/reality_key_share"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_l_file_key"
            app:key="realityMldsa65Verify"
            app:summary="@string/reality_mldsa65_summary"
            app:title="@string/reality_mldsa65" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="serverMuxCategory"
        app:title="@string/mux_preference">
        <SwitchPreference
            app:icon="@drawable/ic_l_combine"
            app:key="enableMux"
            app:summary="@string/mux_sum"
            app:title="@string/enable_mux" />
        <io.niko.ui.SimpleMenuPreference
            app:defaultValue="0"
            app:entries="@array/mux_type"
            app:entryValues="@array/int_array_3"
            app:key="muxType"
            app:title="@string/mux_type"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:defaultValue="1"
            app:icon="@drawable/ic_l_gauge"
            app:key="muxConcurrency"
            app:title="@string/mux_concurrency"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:icon="@drawable/ic_l_space"
            app:key="muxPadding"
            app:title="@string/padding" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="serverECHCategory"
        app:title="ECH">
        <SwitchPreference
            app:icon="@drawable/ic_l_shield_check"
            app:key="enableECH"
            app:title="@string/enable" />
        <EditTextPreference
            app:icon="@drawable/ic_l_file_lock"
            app:key="echConfig"
            app:title="@string/ech_config"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

</PreferenceScreen>