<?xml version="1.0" encoding="utf-8"?>
<!-- UI probe (docs/research/ui-probe.md), the Views half: the canvas's Главная · Простой (P-Simple) with fixed values.
     ProbeComposeActivity draws the same in Compose. The window's background is surface-0 (Theme.SagerNet.Niko) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- m-topbar (brand): the wordmark and the view switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/niko_size_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/niko_space_5"
            android:paddingEnd="@dimen/niko_space_5">

            <TextView
                android:id="@+id/probe_wordmark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/geist"
                android:letterSpacing="-0.04"
                android:textColor="@color/niko_ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/probe_capsule_track"
                android:orientation="horizontal"
                android:padding="@dimen/niko_space_1">

                <TextView
                    android:id="@+id/probe_simple"
                    style="@style/TextAppearance.Niko.BodySm"
                    android:layout_width="120dp"
                    android:layout_height="40dp"
                    android:background="@drawable/probe_capsule_ink"
                    android:gravity="center"
                    android:textColor="@color/niko_on_ink"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/probe_advanced"
                    style="@style/TextAppearance.Niko.BodySm"
                    android:layout_width="120dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/niko_space_1"
                    android:gravity="center"
                    android:textColor="@color/niko_ink_2"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- m-connect (on), its halo space-4 outside it -->
            <FrameLayout
                android:layout_width="192dp"
                android:layout_height="192dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="152dp"
                android:background="@drawable/probe_connect_ring">

                <ImageButton
                    android:id="@+id/probe_connect"
                    android:layout_width="@dimen/niko_size_connect"
                    android:layout_height="@dimen/niko_size_connect"
                    android:layout_gravity="center"
                    android:background="@drawable/probe_connect_on"
                    android:padding="60dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Отключить"
                    android:src="@drawable/ic_l_power"
                    app:tint="@color/niko_on_ink" />
            </FrameLayout>

            <!-- m-status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/niko_space_5"
                android:layout_marginTop="376dp"
                android:layout_marginEnd="@dimen/niko_space_5"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/probe_status"
                    style="@style/TextAppearance.Niko.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/niko_ink" />

                <TextView
                    android:id="@+id/probe_detail"
                    style="@style/TextAppearance.Niko.Code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/niko_space_1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/niko_ink_2" />
            </LinearLayout>

            <!-- m-tiles: Подключение across both columns, then Режим and Маршрут -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/niko_space_5"
                android:layout_marginEnd="@dimen/niko_space_5"
                android:layout_marginBottom="138dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/probe_tile_connection"
                    layout="@layout/probe_tile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/niko_space_2"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/probe_tile_mode"
                        layout="@layout/probe_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/probe_tile_route"
                        layout="@layout/probe_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/niko_space_2"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- m-sheet: the node in use -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/probe_sheet"
        android:orientation="vertical">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/niko_space_2"
            android:layout_marginBottom="@dimen/niko_space_2"
            android:background="@drawable/probe_handle" />

        <LinearLayout
            android:id="@+id/probe_node"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/niko_space_4"
            android:paddingTop="@dimen/niko_space_3"
            android:paddingEnd="@dimen/niko_space_4"
            android:paddingBottom="@dimen/niko_space_6">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/probe_node_name"
                    style="@style/TextAppearance.Niko.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/niko_ink"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/probe_node_until"
                        style="@style/TextAppearance.Niko.BodySm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/niko_ink_2" />

                    <TextView
                        android:id="@+id/probe_node_traffic"
                        style="@style/TextAppearance.Niko.Code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/niko_ink_2" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/probe_node_ping"
                style="@style/TextAppearance.Niko.Code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/niko_space_3"
                android:drawablePadding="@dimen/niko_space_2"
                android:gravity="center_vertical"
                android:textColor="@color/niko_ink_2"
                app:drawableEndCompat="@drawable/ic_l_chevrons_up_down"
                app:drawableTint="@color/niko_ink_2" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
