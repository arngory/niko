<?xml version="1.0" encoding="utf-8"?>
<!-- UI probe (docs/research/ui-probe.md): a tile, m-tile: its icon and a chevron on top, the label and the value below -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/probe_tile"
    android:minHeight="104dp"
    android:orientation="vertical"
    android:padding="@dimen/niko_space_4">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="20dp">

        <ImageView
            android:id="@+id/probe_tile_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="start"
            android:importantForAccessibility="no"
            app:tint="@color/niko_ink_2" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_l_chevron_right"
            app:tint="@color/niko_ink_2" />
    </FrameLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="@dimen/niko_space_4" />

    <TextView
        android:id="@+id/probe_tile_label"
        style="@style/TextAppearance.Niko.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/niko_ink_2" />

    <TextView
        android:id="@+id/probe_tile_value"
        style="@style/TextAppearance.Niko.Headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/niko_ink" />
</LinearLayout>
