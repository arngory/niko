<?xml version="1.0" encoding="utf-8"?>
<!-- A settings group's title (D-SET): a label in Geist Mono, capitals, ink-2, on the screen's surface-0 over its group,
     at the group's inset (space-4; NikoPreferenceGroups keeps the screen's side margin). The font is set here: the
     theme's fontFamily overrides a textAppearance's, and the library's layout gives the title no font of its own. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:accessibilityHeading="true"
    android:fontFamily="@font/geist_mono_medium"
    android:paddingStart="@dimen/niko_space_4"
    android:paddingTop="@dimen/niko_space_5"
    android:paddingEnd="@dimen/niko_space_4"
    android:paddingBottom="@dimen/niko_space_2"
    android:textAlignment="viewStart"
    android:textAppearance="@style/TextAppearance.Niko.Label"
    android:textColor="@color/niko_ink_2" />
