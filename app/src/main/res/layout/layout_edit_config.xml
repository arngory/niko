<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/niko_stroke_hairline"
        android:background="@color/niko_line" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.blacksquircle.ui.editorkit.widget.TextProcessor
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:completionThreshold="2"
            android:importantForAutofill="no"
            android:scrollbars="none" />

        <com.blacksquircle.ui.editorkit.widget.TextScroller
            android:id="@+id/scroller"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            app:thumbTint="?colorPrimary" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/keyboard_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/niko_surface_1"
        android:foreground="@drawable/niko_hairline_top"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/action_tab"
            android:contentDescription="@string/insert_tab"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?selectableItemBackground"
            android:padding="8dp"
            android:src="@drawable/ic_l_arrow_right_to_line"
            app:tint="?android:textColorPrimary" />

        <io.niko.ui.ExtendedKeyboard
            android:id="@+id/extended_keyboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="6"
            tools:listitem="@layout/item_keyboard_key" />

        <ImageView
            android:id="@+id/action_undo"
            android:contentDescription="@string/undo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?selectableItemBackground"
            android:padding="8dp"
            android:src="@drawable/ic_l_undo_2"
            app:tint="?android:textColorPrimary" />

        <ImageView
            android:id="@+id/action_redo"
            android:contentDescription="@string/redo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?selectableItemBackground"
            android:padding="8dp"
            android:src="@drawable/ic_l_redo_2"
            app:tint="?android:textColorPrimary" />

        <ImageView
            android:id="@+id/action_format"
            android:contentDescription="@string/format_config"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?selectableItemBackground"
            android:padding="8dp"
            android:src="@drawable/ic_l_align_left"
            app:tint="?android:textColorPrimary" />

    </LinearLayout>

</LinearLayout>