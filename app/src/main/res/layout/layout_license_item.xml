<?xml version="1.0" encoding="utf-8"?>
<!-- a part of the licenses' list: its name (body), its licenses and version (code, ink-2); a tap opens their texts -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:focusable="true"
    android:minHeight="@dimen/niko_size_tap"
    android:orientation="vertical"
    android:paddingStart="@dimen/niko_space_4"
    android:paddingTop="@dimen/niko_space_3"
    android:paddingEnd="@dimen/niko_space_4"
    android:paddingBottom="@dimen/niko_space_3">

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Niko.Body"
        android:textColor="?android:attr/textColorPrimary"
        android:textDirection="locale" />

    <TextView
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Niko.Code"
        android:fontFamily="@font/geist_mono"
        app:fontFamily="@font/geist_mono"
        android:textColor="?android:attr/textColorSecondary"
        android:textDirection="ltr" />

</LinearLayout>
