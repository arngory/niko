<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Niko's viewfinder: light ink corners, a hairline frame and a scanning line over the scrim; the screen is dark
         in either mode (ScannerActivity), so the night tokens give the light ink and the denser scrim -->
    <com.king.zxing.ViewfinderView
        android:id="@+id/viewfinderView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cornerColor="@color/niko_ink"
        app:frameColor="@color/niko_ink_2"
        app:frameLineWidth="@dimen/niko_stroke_hairline"
        app:labelTextColor="@color/niko_ink"
        app:laserColor="@color/niko_ink"
        app:laserStyle="line"
        app:maskColor="@color/niko_scrim" />

    <ImageView
        android:id="@+id/ivFlashlight"
        android:contentDescription="@string/flashlight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/zxl_flashlight_margin_top"
        android:src="@drawable/zxl_flashlight_selector" />
</FrameLayout>