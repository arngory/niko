# test data signed or hashed byte for byte: a Windows checkout (core.autocrlf) would turn its line ends into CRLF and
# the signature would no longer hold (the desktop workflow's tests on windows-latest)
libcore/minisign/testdata/** -text
# a subscription's body as the provider sent it, its line ends too (shared/golden/subscriptions: a body of CRLF lines)
shared/golden/subscriptions/**/body.* -text
