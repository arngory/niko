# The slipstream server the app's slipstream row is checked against, in the e2e (.github/workflows/ci.yml) and the
# raycontrol interop (raycontrol-interop.yml): the release raycontrol ships (arngory/slipstream, the server's
# session's tag), the same as raycontrol's deploy/versions.env.
SLIPSTREAM_SERVER_RELEASES="https://github.com/arngory/slipstream/releases"
SLIPSTREAM_SERVER_TAG="server-v0.2.0"
SLIPSTREAM_SERVER_SHA256_AMD64="59a0c3eb2a8bbbd8bdbd54c9ae8330d6e5e0dd328acab0e27d2f6f574d377b3f"
