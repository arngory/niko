# The niko-server release the client is checked against (.github/workflows/niko-server-interop.yml): the release
# raycontrol pins in deploy/versions.env (v0.18.3 since raycontrol v0.31.3, pinned in raycontrol.env). v0.18.3: v0.18.2's code from the
# recreated repository (its history rewritten for the root commit's author, the releases before it not carried
# over), built the same way; a pre-release, as all of niko-server's, held here by its SHA-256.
NIKO_SERVER_RELEASES="https://github.com/arngory/niko-server/releases"
NIKO_SERVER_TAG="v0.18.3"
NIKO_SERVER_SHA256_AMD64="07047e51f0ff1dea4a0822acfb99c56dc477bc6eb0cda2716349536e259ee16a"
# A release before niko-ack (v0.14.1): honest connect must give way to it (a node rolled back under links that still
# say niko-ack=1), checked on every push by the job's legacy run. The recreated repository has no v0.14.0, so the
# binary comes from raycontrol v0.20.0's release archive, whose VERSIONS name niko-server v0.14.0 (24d6b61, the old
# history's): the archive held by its SHA-256 (the release's SHA256SUMS, signed with raycontrol's key), the binary by
# its own, the same as the old release's
NIKO_SERVER_LEGACY_TAG="v0.14.0"
NIKO_SERVER_LEGACY_ARCHIVE="https://github.com/arngory/raycontrol/releases/download/v0.20.0/raycontrol-linux-amd64.tar.gz"
NIKO_SERVER_LEGACY_ARCHIVE_SHA256="7a38c44f71b67754a3dfe2a3d238bbb024fb17eecd7e5be6808834c847ae073b"
NIKO_SERVER_LEGACY_SHA256_AMD64="b17b00e1ea271fbcd6373417365750a66be323bac54ac220bf740acb7cfb2dbc"
