# The Chrome the references are captured from: the release naive's library is built of (the owner's rule: the
# target is the Chrome of the library's Chromium, 158 today), not whatever the runner's image carries.
# fingerprint.yml refuses a major that is not the library's.
#
# On 2026-11-17 no channel serves 158: stable is 157.0.8103.78, beta has moved on to 159. So 158 is the last package
# of its beta, by its hash. When 158 is stable, CHROME_REFERENCE_DEB goes empty: the current stable from Google is
# taken then. At the library's next Chromium the major here moves with it.
CHROME_REFERENCE_MAJOR=158
CHROME_REFERENCE_DEB="https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-beta/google-chrome-beta_158.0.8127.18-1_amd64.deb"
CHROME_REFERENCE_DEB_SHA256="461c4af29c34d038d1b28c6dc2951e5cdb183776f2d644510543ea108a345e68"
