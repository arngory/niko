# raycontrol (public) for .github/workflows/raycontrol-interop.yml: the commit whose rayd the client is checked against.
REPOSITORY_RAYCONTROL="https://github.com/arngory/raycontrol.git"
# v0.27.0 (a device revoked renews its user's credentials, RenewUser; a DoH token per device, refused with an empty
# 404 from the first request after RevokeDevice; the node's own outbound TLS trusts its embedded roots, extra ones
# through rayd serve -tls-roots; the REALITY target option; latest_patch, GetPorts; the traffic count fixed in
# 50e6be8, interop run 43665257181 on it). Since v0.26.0 the site's key pins (cert-pin-v1: niko-pin in naive,
# hy2-masq and DoH rows), honest connect in rayd naive, rayctl for macOS and FreeBSD; its Xray fork at 46b58d4;
# per-user connection limits since v0.25.0; Register again with the same key, a key switch within the grace refused
# unless forced and naive's 429 since v0.24.0; lan-v1 since v0.23.0, the traffic limit since v0.22.0, icmp-v1, the
# node's note and niko-ack=1 since v0.21.0, each device its own Yggdrasil key since v0.20.1, UDP through naive since
# v0.20.0; niko-server v0.17.1 and slipstream-server server-v0.2.0 in its VERSIONS). Its SHA256SUMS signed with the
# key A9C7802E23B87A01, the tag on this commit
COMMIT_RAYCONTROL="4e772ac4a5fcca9d5850038b0786ae7181be8d0a"
# NaiveProxy's own client, a release of klzgrad's: the reference client of the naive job. The app's library is
# another build, Chromium 158 from arngory/cronet-go (libcore/go.mod)
NAIVE_CHROMIUM="154.0.8037.49"
