# raycontrol (public) for .github/workflows/raycontrol-interop.yml: the commit whose rayd the client is checked against.
REPOSITORY_RAYCONTROL="https://github.com/arngory/raycontrol.git"
# v0.24.0 (Register again with the same client key within 15 minutes gets the same device; a switch of a dnstt or
# masterdns key within the previous one's grace refused unless forced; naive's connection limits answer 429; built
# with go1.26.10 since v0.23.1; lan-v1 since v0.23.0, the traffic limit since v0.22.0, icmp-v1, the node's note and
# niko-ack=1 since v0.21.0, each device its own Yggdrasil key since v0.20.1, UDP through naive since v0.20.0;
# niko-server v0.16.1 and slipstream-server server-v0.2.0 in deploy/versions.env)
COMMIT_RAYCONTROL="cc70de63a3a07b00e5d6469bd0790e105137e996"
# NaiveProxy client of the same Chromium as the arngory/naiveproxy fork the Niko plugin is built from
NAIVE_CHROMIUM="154.0.8037.49"
